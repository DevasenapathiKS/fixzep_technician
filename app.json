{
  "expo": {
    "name": "Fixzep Crew",
    "slug": "fixzep_technician",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fixzeptechnician",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#111827",
      "androidMode": "default",
      "androidCollapsedTitle": "Fixzep"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fixzeptechinician",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FixZep shares your live location with the operations team while you are signed in so dispatch can assign nearby jobs.",
        "NSLocationWhenInUseUsageDescription": "FixZep uses your location for job check-in and live dispatch visibility.",
        "NSLocationAlwaysUsageDescription": "Background location keeps dispatch updated while you are on duty.",
        "NSCameraUsageDescription": "FixZep uses the camera for face sign-in and for punch in/out photos."
      }
    },
    "android": {
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devasenapathi.fixzep_technician"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Euclid-Circular-B-Light.ttf",
            "./assets/fonts/Euclid-Circular-B-Regular.ttf",
            "./assets/fonts/Euclid-Circular-B-Medium.ttf",
            "./assets/fonts/Euclid-Circular-B-SemiBold.ttf",
            "./assets/fonts/Euclid-Circular-B-Bold.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#111827",
          "sounds": ["./assets/sounds/job_alert.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FixZep shares your live location with dispatch while you are signed in.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FixZep uses the camera for face sign-in and punch photos.",
          "microphonePermission": "FixZep does not record audio for face photos.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "fixzep",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6852c7e4-9df7-49fa-ab72-02faeff422f5"
      }
    }
  }
}
